# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_IDS=

# LLM
LLM_PROVIDER=gemini               # gemini | anthropic | deepseek
LLM_MODEL=gemini-3.6-flash        # p. ej. gemini-3.6-flash | claude-haiku-4-5 | (modelo DeepSeek con visión)
LLM_API_KEY=

# Google
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_TOKEN_JSON=          # token OAuth de Marcelo (scripts/autorizar_google.py), ADR 0006

# Jobs (Cloud Scheduler → /jobs/fx y /jobs/reporte)
JOBS_OIDC_EMAIL=                  # service account que firma el OIDC; vacío = solo disparo manual
JOBS_AUDIENCE=                    # URL del servicio en Cloud Run; vacía = la URL del request

# App
TZ=America/Montevideo
PENDIENTE_TTL_HOURS=48
FX_API_URL=                   # vacío = https://open.er-api.com/v6/latest/USD (ADR 0007)
LOG_LEVEL=INFO
LOG_FORMAT=json               # json (Cloud Run) | console (local)
PORT=8080                     # Cloud Run la inyecta; local opcional
